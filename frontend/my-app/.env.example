# URL du backend utilisée par Next.js côté serveur et par le proxy même origine.
# Local : http://localhost:8000
# Production : https://blog-28ci.onrender.com
API_URL=https://blog-28ci.onrender.com

# Fallback compatible avec les installations existantes. Ne pas l'utiliser
# en production si API_URL est déjà renseignée.
NEXT_PUBLIC_API_URL=https://blog-28ci.onrender.com

# URL canonique publique du frontend, sans slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
