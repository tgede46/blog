{
  "rootDirectory": "frontend/my-app",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "API_URL": "https://blog-28ci.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://blog-28ci.onrender.com"
  },
  "rewrites": [
    {
      "source": "/backend-api/:path*",
      "destination": "https://blog-28ci.onrender.com/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://blog-28ci.onrender.com/uploads/:path*"
    }
  ]
}
